# ===============================================================
# goWILD Karunadu - Admin API Environment Configuration Template
# ===============================================================
# IMPORTANT: Copy this file to .env and replace placeholders with
# your environment-specific credentials. Never commit production .env to git.

# Application Server
PORT=4001
CORS_ORIGINS=http://localhost:4600,http://localhost:4700,http://localhost:4200,http://localhost:8100,https://admin.gowildkarunadu.online,https://admin.gowildkarunadu.com
ADMIN_SOCKET_URL=http://localhost:4001
USER_API_URL=http://localhost:4002

# Authentication & Encryption Secrets
JWT_SECRET=your_jwt_secret_min_32_chars
RESPONSE_ENCRYPTION_KEY=your_admin_encryption_key
ENCRYPTION_SALT=your_encryption_salt

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=goWILDKarunadu

# Storage Provider: 'local' or 's3'
STORAGE_MODE=local

# AWS S3 & CloudFront Configuration (Active when STORAGE_MODE=s3)
AWS_REGION=ap-south-1
S3_BUCKET=gowild-karunadu-images
ADMIN_AWS_ACCESS_KEY=your_aws_access_key_id
ADMIN_AWS_SECRET_KEY=your_aws_secret_access_key
CLOUDFRONT_URL=https://images.gowildkarunadu.online

# Cloudinary (Optional fallback)
CLOUD_NAME=your_cloudinary_name
API_KEY=your_cloudinary_key
API_SECRET=your_cloudinary_secret
