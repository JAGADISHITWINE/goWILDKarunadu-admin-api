# Production environment template for the admin API
# Copy this file to .env in the deployment environment and replace all placeholder values.

PORT=4001
JWT_SECRET=replace_with_strong_random_secret
RESPONSE_ENCRYPTION_KEY=replace_with_secure_random_string
ENCRYPTION_SALT=replace_with_random_salt

CORS_ORIGINS=https://admin.example.com,https://www.example.com
ADMIN_SOCKET_URL=https://admin-api.example.com

# Database
DB_HOST=prod-db-host
DB_PORT=3306
DB_USER=prod_db_user
DB_PASSWORD=prod_db_password
DB_NAME=gowild_karunadu_admin

# Cloud / image settings
CLOUD_NAME=your_cloud_name
API_KEY=your_cloud_api_key
API_SECRET=your_cloud_api_secret

# Storage mode: local or s3
STORAGE_MODE=s3
AWS_REGION=ap-south-1
S3_BUCKET=gowild-karunadu-images
ADMIN_AWS_ACCESS_KEY=replace_with_aws_access_key
ADMIN_AWS_SECRET_KEY=replace_with_aws_secret_key
CLOUDFRONT_URL=https://images.example.com

# Optional application tuning
RATE_LIMIT_MAX=100
